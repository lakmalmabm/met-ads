<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Miss Dior — Mobile Interscroller</title>
<link rel="icon" href="data:," />

<style>
  /* ---------------------------------------------------------------
     DIMENSIONS — from spec
       page width   768px
       top section   768 × 1824  (24px L/R padding)
       video         768 × 1152
       bottom        768 × 1824  (24px L/R padding)
     --------------------------------------------------------------- */
  :root {
    --page-w:    768px;
    --section-h: 1824px;
    --video-h:   1152px;
    --video-w:   768px;
    --pad-x:     24px;
    --sk:        #e5e5e5;
    --gap:       12px;
    --r:         4px;
  }

  @media (max-width: 768px) {
    :root {
      --page-w:    448px;
      --section-h: 1824px;
      --video-h:   669px;
      --video-w:   430px;
      --pad-x:     24px;
    }
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: auto;
    overscroll-behavior: none;
  }

  body {
    margin: 0;
    background: #f5f5f5;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .page {
    position: relative;
    width: var(--page-w);
    max-width: 100%;
    margin: 0 auto;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05),
                0 20px 50px rgba(0, 0, 0, 0.08);
    /* no overflow:hidden — it breaks position:sticky on the video */
  }

  /* ---------------------------------------------------------------
     PUBLISHER MOCK — skeleton content. z-index 20 so it slides
     OVER the sticky video beneath it.
     --------------------------------------------------------------- */
  .mock {
    position: relative;
    z-index: 20;
    background: #fff;
    min-height: var(--section-h);
    padding: 40px var(--pad-x);
  }
  .mock--bottom { margin-bottom: 75px; }

  /* Shared skeleton bar */
  .s { border-radius: var(--r); background: var(--sk); }

  /* ---- Pattern A: text lines (5-col grid) -------------------- */
  .pa {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--gap);
    margin-bottom: 16px;
  }
  .pa .s { height: 12px; }
  .pa .s--full { grid-column: span 5; }
  .pa .s--short { grid-column: span 2; }
  .pa .s--3 { grid-column: span 3; }
  .pa .s--1 { grid-column: span 1; }

  /* ---- Pattern B: media block (5-col grid) ------------------- */
  .pb {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--gap);
    margin-bottom: 16px;
  }
  .pb .s { height: 12px; }
  .pb .s--img { grid-column: span 3; grid-row: span 2; height: auto; min-height: 64px; }
  .pb .s--thumb { grid-column: span 1; height: 64px; }
  .pb .s--3 { grid-column: span 3; }
  .pb .s--2 { grid-column: span 2; }
  .pb .s--1 { grid-column: span 1; }

  /* ---- Pattern C: article row (5-col, split 3+2) ------------- */
  .pc {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--gap);
    margin-bottom: 16px;
  }

  /* Left: thumbnail + text lines */
  .pc__left {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--gap);
    align-content: start;
  }
  .pc__left .s--pic { grid-row: span 6; min-height: 72px; }
  .pc__left .s { height: 12px; }

  /* Right: two mini-cards stacked */
  .pc__right {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .pc__card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
    align-content: start;
  }
  .pc__card .s--pic { grid-column: span 1; grid-row: span 3; min-height: 48px; }
  .pc__card .s { height: 12px; }
  .pc__card .s--w1 { grid-column: span 1; }

  /* ---------------------------------------------------------------
     STICKY VIDEO — z-index 10, revealed as mock scrolls past.
     --------------------------------------------------------------- */
  .ad {
    position: sticky;
    bottom: 0;
    z-index: 10;
    width: var(--video-w);
    height: var(--video-h);
    margin: 0 auto;
    /* Was #000. The Blender backdrop is a light grey gradient (sampled
       #dadddf -> #abadae down the frame), so grey fails far less visibly
       than black during load. */
    background: #d5d6d8;
    overflow: hidden;
  }

  /* The canvas replaces the <video> at IDENTICAL geometry. It fills .ad
     exactly, so there is no object-fit: the crop that object-fit:cover used
     to perform is now done by the camera's FOV (see CAM in the script).
     scale(1.08) is kept verbatim - it is what gives the gyro translate its
     overscan, and it is part of the framing match. */
  .ad canvas {
    display: block;
    width: 100%;
    height: 100%;
    transform: scale(1.08);
    will-change: transform;
  }

  /* Load readout. model.glb is ~357 MB unoptimised, so this is not optional. */
  .ad__loader {
    position: absolute;
    inset: 0;
    z-index: 12;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #d5d6d8;
    color: #555;
    font-size: 13px;
    letter-spacing: 0.02em;
    transition: opacity 0.4s;
  }
  .ad__loader.hidden { opacity: 0; pointer-events: none; }
  .ad__bar {
    width: 140px;
    height: 2px;
    background: rgba(0, 0, 0, 0.12);
    overflow: hidden;
  }
  .ad__bar i {
    display: block;
    width: 0%;
    height: 100%;
    background: #c2185b;
    transition: width 0.2s linear;
  }

  /* Per-part readout. Absolutely positioned INSIDE .ad so the div's fixed
     768x1152 / 430x669 geometry is untouched. __ad.showStats(false) hides it. */
  .ad__stats {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 13;
    margin: 0;
    padding: 8px 10px;
    background: rgba(255, 255, 255, 0.72);
    color: #333;
    font: 11px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    white-space: pre;
    border-radius: 3px;
    pointer-events: none;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* iOS gyro permission prompt */
  .gyro-prompt {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 15;
    padding: 10px 20px;
    background: rgba(255, 255, 255, 0.9);
    color: #000;
    font-size: 13px;
    border-radius: 20px;
    white-space: nowrap;
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
    transition: opacity 0.3s;
  }
  .gyro-prompt.hidden { opacity: 0; pointer-events: none; }

  .light-controls {
    position: fixed;
    top: 10px;
    right: 10px;
    z-index: 100;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 12px 14px;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.12);
    font: 12px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #333;
    min-width: 220px;
    max-height: 90vh;
    overflow-y: auto;
  }
  .light-controls h4 {
    margin: 8px 0 4px;
    font-size: 11px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .light-controls h4:first-child { margin-top: 0; }
  .light-controls .copy-btn {
    display: block;
    width: 100%;
    margin-top: 8px;
    padding: 6px;
    background: #333;
    color: #fff;
    border: none;
    border-radius: 4px;
    font: inherit;
    cursor: pointer;
  }
  .light-controls .copy-btn:active { background: #555; }
  .light-controls label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }
  .light-controls input[type=range] {
    flex: 1;
    max-width: 110px;
  }
  .light-controls span.val {
    min-width: 36px;
    text-align: right;
  }

  .ad__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #666;
    font-size: 14px;
    text-align: center;
    padding: var(--pad-x);
  }
</style>
</head>

<body>

<div class="light-controls" id="lc" style="display:none">
  <h4>Shadow light</h4>
  <label>X <input type="range" id="lx" min="-4" max="8" step="0.1" value="6.4"><span class="val" id="lx-v">6.4</span></label>
  <label>Y <input type="range" id="ly" min="-4" max="4" step="0.1" value="1.0"><span class="val" id="ly-v">1.0</span></label>
  <label>Z <input type="range" id="lz" min="-2" max="6" step="0.1" value="4.6"><span class="val" id="lz-v">4.6</span></label>
  <label>Bright <input type="range" id="lb" min="0" max="10" step="0.1" value="5"><span class="val" id="lb-v">5.0</span></label>
  <label><input type="checkbox" id="t-shadow" checked> On</label>
  <h4>Area lights</h4>
  <div id="area-controls"></div>
  <label><input type="checkbox" id="t-area" checked> All on</label>
  <h4>Box</h4>
  <label>Width <input type="range" id="bw" min="0.01" max="1.2" step="0.01" value="0.76"><span class="val" id="bw-v">0.76</span></label>
  <label>Height <input type="range" id="bh" min="0.01" max="1.2" step="0.01" value="1.12"><span class="val" id="bh-v">1.12</span></label>
  <label>Depth <input type="range" id="bd" min="0.1" max="20" step="0.1" value="1"><span class="val" id="bd-v">1.0</span></label>
  <label><input type="checkbox" id="t-edges" checked> Show edges</label>
  <h4>Materials</h4>
  <label><input type="checkbox" id="t-matoverride"> Material overrides</label>
  <h4>Camera</h4>
  <label>Zoom <input type="range" id="cam-z" min="0.5" max="20" step="0.1" value="3.97"><span class="val" id="cam-z-v">3.97</span></label>
  <h4>Environment</h4>
  <label>HDRI <input type="range" id="hdri-int" min="0" max="3" step="0.05" value="1"><span class="val" id="hdri-v">1.0</span></label>
  <label>Exposure <input type="range" id="exposure" min="0" max="3" step="0.05" value="0.35"><span class="val" id="exp-v">0.35</span></label>
  <button class="copy-btn" id="copy-btn">Copy values</button>
</div>

<div class="page">

  <!-- ============================================================
       TOP SECTION — 768 × 1824
       ============================================================ -->
  <div class="mock">

    <!-- --- Group 1 --- -->
    <div class="pa">
      <div class="s s--full"></div>
      <div class="s s--full"></div>
      <div class="s s--short"></div>
    </div>
    <div class="pb">
      <div class="s s--img"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--3"></div>
      <div class="s s--2"></div>
      <div class="s s--3"></div>
      <div class="s s--1"></div>
      <div class="s s--2"></div>
    </div>
    <div class="pc">
      <div class="pc__left">
        <div class="s s--pic"></div>
        <div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div>
      </div>
      <div class="pc__right">
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
      </div>
    </div>
    <div class="pc">
      <div class="pc__left">
        <div class="s s--pic"></div>
        <div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div>
      </div>
      <div class="pc__right">
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
      </div>
    </div>

    <!-- --- Group 2 --- -->
    <div class="pa">
      <div class="s s--full"></div>
      <div class="s s--full"></div>
      <div class="s s--short"></div>
    </div>
    <div class="pb">
      <div class="s s--img"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--3"></div>
      <div class="s s--2"></div>
      <div class="s s--3"></div>
      <div class="s s--1"></div>
      <div class="s s--2"></div>
    </div>
    <div class="pc">
      <div class="pc__left">
        <div class="s s--pic"></div>
        <div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div>
      </div>
      <div class="pc__right">
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
      </div>
    </div>
    <div class="pc">
      <div class="pc__left">
        <div class="s s--pic"></div>
        <div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div>
      </div>
      <div class="pc__right">
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
      </div>
    </div>

    <!-- --- Group 3 --- -->
    <div class="pa">
      <div class="s s--full"></div>
      <div class="s s--full"></div>
      <div class="s s--short"></div>
    </div>
    <div class="pb">
      <div class="s s--img"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--3"></div>
      <div class="s s--2"></div>
      <div class="s s--3"></div>
      <div class="s s--1"></div>
      <div class="s s--2"></div>
    </div>
    <div class="pc">
      <div class="pc__left">
        <div class="s s--pic"></div>
        <div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div>
      </div>
      <div class="pc__right">
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
      </div>
    </div>
    <div class="pc">
      <div class="pc__left">
        <div class="s s--pic"></div>
        <div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div>
      </div>
      <div class="pc__right">
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
      </div>
    </div>

    <!-- --- Group 4 (partial — fills remaining height) --- -->
    <div class="pa">
      <div class="s s--full"></div>
      <div class="s s--full"></div>
      <div class="s s--short"></div>
    </div>
    <div class="pb">
      <div class="s s--img"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--thumb"></div>
      <div class="s s--3"></div>
      <div class="s s--2"></div>
      <div class="s s--3"></div>
      <div class="s s--1"></div>
      <div class="s s--2"></div>
    </div>
    <div class="pc">
      <div class="pc__left">
        <div class="s s--pic"></div>
        <div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div><div class="s"></div>
      </div>
      <div class="pc__right">
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
        <div class="pc__card"><div class="s s--pic"></div><div class="s"></div><div class="s s--w1"></div><div class="s"></div></div>
      </div>
    </div>

  </div>

  <!-- ============================================================
       STICKY VIDEO — 768 × 1152
       ============================================================ -->
  <div class="ad" id="ad">
    <canvas id="stage"></canvas>
    <pre class="ad__stats" id="stats"></pre>
    <div class="ad__loader" id="loader">
      <div class="ad__bar"><i id="bar"></i></div>
      <div id="loader-text">loading scene</div>
    </div>
    <div class="gyro-prompt" id="gyro-prompt">Tap to enable motion</div>
  </div>

  <!-- ============================================================
       BOTTOM SECTION — 768 × 1824
       ============================================================ -->
  <div class="mock mock--bottom">

    <!-- --- Group 1 --- -->
    <div class="pa">
      <div class="s s--full"></div>
      <div class="s s--full"></div>
      <div class="s s--short"></div>
    </div>
    <div class="pb">
      <div class="s s--img"></div>
      <div class="s s--thumb"></div>
