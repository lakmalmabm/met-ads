</div><!-- /.page -->

<script>
(function () {
  'use strict';

  var video = document.getElementById('video');
  var prompt = document.getElementById('gyro-prompt');
  var EASE = 0.08;
  var MAX_SHIFT = 20; /* px */
  var targetX = 0, targetY = 0;
  var currentX = 0, currentY = 0;
  var gyroActive = false;

  /* Video error fallback */
  video.addEventListener('error', function () {
    var ph = document.createElement('div');
    ph.className = 'ad__placeholder';
    ph.textContent = 'Drop video.mp4 into the miss_dior_mobile folder';
    video.parentNode.appendChild(ph);
    video.style.display = 'none';
  }, true);

  /* --- Gyro tilt ----------------------------------------------- */
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

  function onOrientation(e) {
    /* beta = front-back (-180..180), gamma = left-right (-90..90) */
    var gamma = e.gamma || 0;
    var beta = e.beta || 0;
    /* Normalise: phone upright ≈ beta 90, so offset by 90 */
    beta = beta - 90;
    targetX = clamp(gamma / 30, -1, 1) * MAX_SHIFT;
    targetY = clamp(beta / 30, -1, 1) * MAX_SHIFT;
  }

  function startGyro() {
    window.addEventListener('deviceorientation', onOrientation);
    gyroActive = true;
    prompt.classList.add('hidden');
  }

  /* rAF loop — ease toward target */
  function tick() {
    if (gyroActive) {
      currentX += (targetX - currentX) * EASE;
      currentY += (targetY - currentY) * EASE;
      video.style.transform =
        'scale(1.08) translate(' + currentX.toFixed(2) + 'px, ' + currentY.toFixed(2) + 'px)';
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);

  /* --- Permission handling ------------------------------------ */
  var needsPermission = typeof DeviceOrientationEvent !== 'undefined' &&
                        typeof DeviceOrientationEvent.requestPermission === 'function';

  if (needsPermission) {
    /* iOS 13+ — must request on user gesture */
    prompt.addEventListener('click', function () {
      DeviceOrientationEvent.requestPermission().then(function (state) {
        if (state === 'granted') startGyro();
        else prompt.classList.add('hidden');
      }).catch(function () {
        prompt.classList.add('hidden');
      });
    });
  } else if ('DeviceOrientationEvent' in window) {
    /* Android / other — just start, hide prompt */
    prompt.classList.add('hidden');
    startGyro();
  } else {
    /* Desktop — no gyro, hide prompt */
    prompt.classList.add('hidden');
  }

})();
</script>
</body>
</html>
