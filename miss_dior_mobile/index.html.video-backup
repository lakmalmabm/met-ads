    <video id="video" preload="auto" playsinline muted loop autoplay>
      <source src="/miss_dior_mobile/video.mp4" type="video/mp4" />
    </video>
    <div class="gyro-prompt" id="gyro-prompt">Tap to enable motion</div>
  </div>

